rules_version = '2';

// GymFlow access model (closed system, no self sign-up):
// - Firebase Auth only proves identity. Access requires an account document users/{uid} with
//   status 'active', which only an admin can create. Accounts registered via the public Auth
//   API therefore can't read or write anything.
// - Roles live in users/{uid}.role ('admin' | 'user'); nobody can change their own role/status.
// - Login by username: usernames/{name} → { uid, email } is read before sign-in to find the
//   login e-mail. Only admins write it, always in one batch with the account it belongs to.
// - The exercise catalog ships with the app, so there is no exercises collection.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function account() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && account().status == 'active';
    }

    function isAdmin() {
      return isActive() && account().role == 'admin';
    }

    // Whole number 1–7. Accepts int and float storage: documents created in the Firebase Console
    // (bootstrap admin) may store 3 as 3.0.
    function validGoal(data) {
      return data.weeklyGoalDays is number
        && data.weeklyGoalDays >= 1 && data.weeklyGoalDays <= 7
        && math.floor(data.weeklyGoalDays) == data.weeklyGoalDays;
    }

    // Weight of one dumbbell in kg (0.5–50): absent on older accounts, which use the app's default.
    function validDumbbell(data) {
      return !('dumbbellKg' in data)
        || (data.dumbbellKg is number && data.dumbbellKg >= 0.5 && data.dumbbellKg <= 50);
    }

    // Gamification mirror (XP, level, rank, achievements): absent until the app's first sync, then
    // always complete. The client derives it from the workout logs; without Cloud Functions the
    // rules can only check shape and plausibility, not recompute it.
    function validProgress(data) {
      return !('totalXP' in data) || (
        data.keys().hasAll(['currentXP', 'totalXP', 'level', 'rank', 'unlockedAchievements'])
        && data.totalXP is int && data.totalXP >= 0
        && data.currentXP is int && data.currentXP >= 0 && data.currentXP <= data.totalXP
        && data.level is int && data.level >= 1 && data.level <= 1000
        && data.rank in ['iron', 'bronze', 'silver', 'gold', 'platinum', 'diamond', 'grandmaster']
        && data.unlockedAchievements is map && data.unlockedAchievements.size() <= 50
      );
    }

    // Keep in sync with src/lib/usernames.ts.
    function validUsername(name) {
      return name is string && name.matches('^[a-z0-9][a-z0-9._-]{2,19}$');
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function usernamePath(name) {
      return /databases/$(database)/documents/usernames/$(name);
    }

    // An account's username must be reserved for exactly this account (mapping written in the
    // same batch). Accounts from before usernames existed have none, which is fine.
    function usernameClaimed(data, uid) {
      return !('username' in data) || (
        validUsername(data.username)
        && getAfter(usernamePath(data.username)).data.uid == uid
      );
    }

    function usernameUnchanged() {
      return request.resource.data.get('username', null) == resource.data.get('username', null);
    }

    // First-run tour: the user sets it once, to the server time, and can never reset it (so the
    // tour can't come back by accident, e.g. from an old client).
    function validOnboarding() {
      return request.resource.data.get('onboardingCompletedAt', null) == resource.data.get('onboardingCompletedAt', null)
        || (resource.data.get('onboardingCompletedAt', null) == null
            && request.resource.data.get('onboardingCompletedAt', null) == request.time);
    }

    function validAccount(data) {
      return data.keys().hasOnly(['email', 'username', 'displayName', 'role', 'status', 'weeklyGoalDays', 'dumbbellKg',
                                  'createdAt', 'createdBy', 'updatedAt', 'lastLoginAt', 'onboardingCompletedAt',
                                  'currentXP', 'totalXP', 'level', 'rank', 'unlockedAchievements'])
        && data.email is string
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 60
        && data.role in ['admin', 'user']
        && data.status in ['active', 'disabled']
        && validGoal(data)
        && validDumbbell(data)
        && validProgress(data);
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ─── users/{uid}: account document ───
    match /users/{uid} {
      // Own document is always readable (also when disabled, so the app can show why).
      allow read: if isSelf(uid) || isAdmin();

      allow create: if isAdmin()
        && validAccount(request.resource.data)
        && usernameClaimed(request.resource.data, uid)
        && request.resource.data.status == 'active'
        && request.resource.data.createdBy == request.auth.uid;

      // Admin: name, username, role and status of any account, but never their own role/status
      // (no lockout). User: only their weekly goal, dumbbell weight, login timestamp, onboarding flag
      // and own XP mirror, and only while active. Nobody else's XP is writable, not even by an admin.
      allow update: if (
          isAdmin()
          && validAccount(request.resource.data)
          && changedOnly(['displayName', 'username', 'role', 'status', 'updatedAt'])
          && (!isSelf(uid) || changedOnly(['displayName', 'username', 'updatedAt']))
          && (usernameUnchanged() || usernameClaimed(request.resource.data, uid))
        ) || (
          isSelf(uid) && isActive()
          && changedOnly(['weeklyGoalDays', 'dumbbellKg', 'updatedAt', 'lastLoginAt', 'onboardingCompletedAt',
                          'currentXP', 'totalXP', 'level', 'rank', 'unlockedAchievements'])
          && validOnboarding()
          && validGoal(request.resource.data)
          && validDumbbell(request.resource.data)
          && validProgress(request.resource.data)
        );

      allow delete: if isAdmin() && !isSelf(uid);

      // ─── users/{uid}/workout_logs/{YYYY-MM-DD}: one document per training day ───
      match /workout_logs/{date} {
        // Admins may read and delete (needed to fully delete an account), but never write.
        allow read: if (isSelf(uid) && isActive()) || isAdmin();
        allow delete: if (isSelf(uid) && isActive()) || (isAdmin() && !isSelf(uid));
        allow create, update: if isSelf(uid) && isActive()
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.date == date
          && request.resource.data.userId == uid
          && request.resource.data.entries is list
          && request.resource.data.entries.size() <= 100;
      }

      // ─── users/{uid}/templates/{id}: own workout templates ───
      match /templates/{templateId} {
        allow read: if (isSelf(uid) && isActive()) || isAdmin();
        allow delete: if (isSelf(uid) && isActive()) || (isAdmin() && !isSelf(uid));
        allow create, update: if isSelf(uid) && isActive()
          && request.resource.data.keys().hasOnly(['name', 'exercises', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
          && request.resource.data.exercises is list
          && request.resource.data.exercises.size() > 0 && request.resource.data.exercises.size() <= 20;
      }

      // ─── users/{uid}/body_weights/{YYYY-MM-DD}: one weigh-in per day ───
      match /body_weights/{date} {
        allow read: if (isSelf(uid) && isActive()) || isAdmin();
        allow delete: if (isSelf(uid) && isActive()) || (isAdmin() && !isSelf(uid));
        allow create, update: if isSelf(uid) && isActive()
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['date', 'weightKg', 'updatedAt'])
          && request.resource.data.date == date
          && request.resource.data.weightKg is number
          && request.resource.data.weightKg >= 20 && request.resource.data.weightKg <= 400;
      }
    }

    // ─── usernames/{name}: username → { uid, email } for the username login ───
    match /usernames/{name} {
      // Resolved before sign-in, so single lookups are public. Listing stays closed: it would hand
      // out every login e-mail at once.
      allow get: if true;
      allow list: if false;

      // Only together with the account that points to it (same batch). Writing an existing name
      // counts as an update and is denied, which is what keeps usernames unique.
      allow create: if isAdmin()
        && validUsername(name)
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid is string
        && getAfter(userPath(request.resource.data.uid)).data.get('username', null) == name
        && getAfter(userPath(request.resource.data.uid)).data.email == request.resource.data.email;

      // Released only when its account is deleted or renamed in the same batch.
      allow delete: if isAdmin()
        && (!existsAfter(userPath(resource.data.uid))
            || getAfter(userPath(resource.data.uid)).data.get('username', null) != name);

      allow update: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
