rules_version = '2';

// GymFlow access model (closed system, no self sign-up):
// - Firebase Auth only proves identity. Access requires an account document users/{uid} with
//   status 'active', which only an admin can create. Accounts registered via the public Auth
//   API therefore can't read or write anything.
// - Roles live in users/{uid}.role ('admin' | 'user'); nobody can change their own role/status.
// - The exercise catalog ships with the app, so there is no exercises collection.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function account() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && account().status == 'active';
    }

    function isAdmin() {
      return isActive() && account().role == 'admin';
    }

    // Whole number 1–7. Accepts int and float storage: documents created in the Firebase Console
    // (bootstrap admin) may store 3 as 3.0.
    function validGoal(data) {
      return data.weeklyGoalDays is number
        && data.weeklyGoalDays >= 1 && data.weeklyGoalDays <= 7
        && math.floor(data.weeklyGoalDays) == data.weeklyGoalDays;
    }

    function validAccount(data) {
      return data.keys().hasOnly(['email', 'displayName', 'role', 'status', 'weeklyGoalDays',
                                  'createdAt', 'createdBy', 'updatedAt', 'lastLoginAt'])
        && data.email is string
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 60
        && data.role in ['admin', 'user']
        && data.status in ['active', 'disabled']
        && validGoal(data);
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ─── users/{uid}: account document ───
    match /users/{uid} {
      // Own document is always readable (also when disabled, so the app can show why).
      allow read: if isSelf(uid) || isAdmin();

      allow create: if isAdmin()
        && validAccount(request.resource.data)
        && request.resource.data.status == 'active'
        && request.resource.data.createdBy == request.auth.uid;

      // Admin: name, role and status of any account, but never their own role/status (no lockout).
      // User: only their weekly goal and login timestamp, and only while active.
      allow update: if (
          isAdmin()
          && validAccount(request.resource.data)
          && changedOnly(['displayName', 'role', 'status', 'updatedAt'])
          && (!isSelf(uid) || changedOnly(['displayName', 'updatedAt']))
        ) || (
          isSelf(uid) && isActive()
          && changedOnly(['weeklyGoalDays', 'updatedAt', 'lastLoginAt'])
          && validGoal(request.resource.data)
        );

      allow delete: if isAdmin() && !isSelf(uid);

      // ─── users/{uid}/workout_logs/{YYYY-MM-DD}: one document per training day ───
      match /workout_logs/{date} {
        // Admins may read and delete (needed to fully delete an account), but never write.
        allow read: if (isSelf(uid) && isActive()) || isAdmin();
        allow delete: if (isSelf(uid) && isActive()) || (isAdmin() && !isSelf(uid));
        allow create, update: if isSelf(uid) && isActive()
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.date == date
          && request.resource.data.userId == uid
          && request.resource.data.entries is list
          && request.resource.data.entries.size() <= 100;
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
